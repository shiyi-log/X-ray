# X-ray 本地开发配置（位于项目根目录）
# 根目录 main.py 会自动读取根目录 .env；仅修改中文注释无需重启。
# 修改配置值后，需要重新运行 main.py 才会加载；前端首选 9528、后端首选 9527，冲突时自动调整。
# .env 保存本机实际配置并保持私有；.env.example 是公开模板，不要填入真实密码或密钥。
# 首次配置时复制为根目录 .env，再填写本机实际值；示例主密钥占位符必须替换后才能用于加密。

# Django 配置模块：根目录启动器只支持 config.settings.test，连接本项目隔离的本地开发环境。
DJANGO_SETTINGS_MODULE=config.settings.test

# 运行环境：本地开发保持 test；与上面的测试配置模块配套使用。
XRAY_ENV=test

# 登录用户名：运行根目录 main.py 时，自动创建或同步本地唯一管理员。
XRAY_ADMIN_USERNAME=admin

# 登录密码：至少 12 个字符；包含空格或 # 时用英文引号包住整个值。
# 修改用户名或密码后，重新运行 main.py 会同步新值，并使原有登录会话失效。
XRAY_ADMIN_PASSWORD=change-this-local-password

# 隔离测试旁路：1 = 跳过 TOTP；0 = 使用正常登录规则。
# 正常规则：未绑定可用密码登录，已绑定需验证 TOTP；绑定由管理员主动选择。
# 旁路仅在上述本地 test 环境生效，生产始终关闭，不影响可选绑定规则。
XRAY_DISABLE_TOTP=1

# 允许提交表单的前端来源：完整填写协议、地址和端口；多个来源用英文逗号分隔。
# 手动启动后端时读取此值；main.py 一键启动会在内存中改用本次实际前端地址。
XRAY_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:9528

# 本项目专用 PostgreSQL 连接地址：默认本机 55432 端口，数据库名必须是 xray_test。
# 连接串包含数据库账号和密码；不要改为其他项目或生产数据库。
XRAY_TEST_DATABASE_URL=postgresql://xray_test:xray_test_only_password@127.0.0.1:55432/xray_test

# 本项目专用 Redis 连接地址：默认本机 56379 端口、数据库编号 0。
# 用于后台任务队列与结果存储，与其他项目的 Redis 配置分开。
XRAY_REDIS_URL=redis://127.0.0.1:56379/0

# 云账号在线身份校验：本地开发设为 1，允许向 AWS / 阿里云 STS 查询密钥所属身份。
# 新增账号、轮换凭据、重新验证账号均可在线校验；如需主动关闭这些校验，可改为 0。
# 此项只控制身份校验入口；创建、停止、删除云资源仍由对应操作流程单独授权。
XRAY_ENABLE_PROVIDER_NETWORK=1

# 控制面加密主密钥：保护云账号凭据、TOTP 等控制面敏感数据。
# 格式为 UTF-8 编码后恰好 32 字节的文本，或解码后为 32 字节的 Base64URL 字符串。
# 已有加密数据时保持原值；直接换值会导致旧数据无法解密，需要专门的密钥迁移流程。
XRAY_CONTROL_MASTER_KEY=test-only-control-key-change-me

# 订阅加密主密钥：保护订阅凭据与订阅内容，和控制面主密钥分开配置。
# 格式同上：32 字节原文或表示 32 字节密钥的 Base64URL 字符串。
# 示例文件中的密钥只是占位符，使用加密功能前须替换为符合格式的值；已有实际密钥不要直接更换。
XRAY_SUBSCRIPTION_MASTER_KEY=test-only-subscription-key-change-me
