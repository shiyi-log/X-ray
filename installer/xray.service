[Unit]
Description=Xray service managed by X-ray Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xray
Group=xray
DynamicUser=yes
LoadCredential=xray-config:/usr/local/etc/xray/config.json
ExecStart=/usr/local/bin/xray run -config ${CREDENTIALS_DIRECTORY}/xray-config -format json
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xray-manager /usr/local/etc/xray
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
