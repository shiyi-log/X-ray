# Copy to backend/.env for local development only. Never commit the copy.
DJANGO_SETTINGS_MODULE=config.settings.test
XRAY_ENV=test
XRAY_TEST_DATABASE_URL=postgresql://xray_test:xray_test_only_password@127.0.0.1:55432/xray_test
XRAY_REDIS_URL=redis://127.0.0.1:56379/0

# P1 crypto tests use ephemeral values. Production keys must be injected by
# the deployment secret manager and must never be placed in this file.
XRAY_CONTROL_MASTER_KEY=test-only-control-key-change-me
XRAY_SUBSCRIPTION_MASTER_KEY=test-only-subscription-key-change-me
