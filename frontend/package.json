{
  "name": "xray-manager-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "10.33.x"
  },
  "scripts": {
    "dev": "pnpm --filter @xray/web-antd dev",
    "typecheck": "pnpm --filter @xray/web-antd typecheck",
    "lint": "eslint apps/web-antd/src packages/ui/src tests/e2e scripts --max-warnings=0 --no-error-on-unmatched-pattern",
    "test:unit": "vitest run --config apps/web-antd/vitest.config.ts",
    "build": "pnpm --filter @xray/web-antd build",
    "test:e2e": "playwright test --config playwright.config.ts",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@types/node": "24.5.2",
    "eslint": "9.36.0",
    "eslint-plugin-vue": "10.5.0",
    "globals": "16.4.0",
    "happy-dom": "18.0.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0"
  }
}
