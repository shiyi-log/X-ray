{
  "extends": "@vben/tsconfig/web-app.json",
  "compilerOptions": {
    "types": [
      "vite/client",
      "vitest/globals",
      "@vben/types/global"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "#/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
